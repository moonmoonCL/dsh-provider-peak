{
  "name": "dsh-provider-peak",
  "version": "1.1.1",
  "private": true,
  "description": "Provider-aware DeepSeek peak/off-peak badge for DSH: shows in the composer toolbar only when the selected model belongs to a DeepSeek provider.",
  "type": "module",
  "license": "MIT",
  "author": "moonmoonCL",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "peak-hours",
    "off-peak"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonmoonCL/dsh-provider-peak.git"
  },
  "homepage": "https://github.com/moonmoonCL/dsh-provider-peak#readme",
  "bugs": {
    "url": "https://github.com/moonmoonCL/dsh-provider-peak/issues"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  }
}
